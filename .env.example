# Required
SNOWFLAKE_ACCOUNT=your_account_locator
SNOWFLAKE_USER=your_username
SNOWFLAKE_ROLE=your_role
SNOWFLAKE_PRIVATE_KEY_PATH=~/path/to/your/key.p8

# Optional — override defaults for a different Snowflake environment
# SNOWFLAKE_DATABASE=AM_SKI_RESORT
# SNOWFLAKE_AGENT_SCHEMA=AGENTS
# SNOWFLAKE_MCP_SCHEMA=MCP_SERVERS
# SNOWFLAKE_MCP_SERVER=ski_resort_mcp
